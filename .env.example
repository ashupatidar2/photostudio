# Application
APP_NAME=PhotoStudio API
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://photostudio:photostudio@localhost:5432/photostudio

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads

# Storage (local or s3)
STORAGE_TYPE=local

# S3 Configuration (if using S3)
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT_URL=  # For S3-compatible services like DigitalOcean Spaces

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@photostudio.com
SMTP_FROM_NAME=PhotoStudio

# Image Processing
GENERATE_WEBP=True

# Pagination
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
